# Defaults for the branches. Override any of them in ~/.pi/agent/delegate.env, which run.sh
# reads after this file.
#
# FAST is the model a branch runs on unless the task names another. The default is this
# session's own model, which pi puts in the environment of every bash call.
FAST=${FAST:-${PI_PROVIDER:+$PI_PROVIDER/${PI_MODEL-}}}
# Seconds before a branch that is still running is cut off.
DELEGATE_TIMEOUT=${DELEGATE_TIMEOUT:-300}
# Extensions every branch loads. Branches start with --no-extensions, so a provider that
# comes from an extension has to be listed here, e.g.
# LOAD="-e $HOME/.pi/agent/npm/node_modules/<provider extension>"
LOAD=${LOAD:-}
